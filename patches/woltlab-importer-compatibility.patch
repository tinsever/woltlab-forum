+    /**
+     * Reuses matching target icons and imports custom reaction types.
+     */
+    public function exportReactionTypes($offset, $limit)
+    {
+        $statement = $this->database->prepareUnmanaged(
+            'SELECT * FROM wcf' . $this->dbNo . '_reaction_type ORDER BY reactionTypeID',
+            $limit,
+            $offset
+        );
+        $statement->execute();
+        $targetStatement = WCF::getDB()->prepare('SELECT reactionTypeID FROM wcf1_reaction_type WHERE iconFile = ?', 1);
+        while ($row = $statement->fetchArray()) {
+            $targetStatement->execute([$row['iconFile']]);
+            $targetID = $targetStatement->fetchSingleColumn();
+            if ($targetID) {
+                ImportHandler::getInstance()->saveNewID('com.woltlab.wcf.reactionType', $row['reactionTypeID'], $targetID);
+                continue;
+            }
+
+            $titles = $this->getI18nValues([$row['title']]);
+            $values = $titles[$row['title']] ?? [];
+            $title = $values[LanguageFactory::getInstance()->getDefaultLanguageID()] ?? (\reset($values) ?: $row['title']);
+            $targetID = ImportHandler::getInstance()->getImporter('com.woltlab.wcf.reactionType')->import(
+                $row['reactionTypeID'],
+                ['title' => $title, 'showOrder' => $row['showOrder']],
+                ['fileLocation' => $this->fileSystemPath . 'images/reaction/' . \basename($row['iconFile'])]
+            );
+            if (!$targetID) {
+                throw new \wcf\system\exception\SystemException('Cannot import reaction icon: ' . $row['iconFile']);
+            }
+        }
+    }
